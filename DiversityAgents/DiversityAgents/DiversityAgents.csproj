<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>DA_C_favicon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>DiversityAgents.Program</StartupObject>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <UseWPF>True</UseWPF>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>4.3.0</Version>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Resources\JsonApi.ico" />
  </ItemGroup>
  <PropertyGroup>
  <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
</PropertyGroup>
  <ItemGroup>
    <Reference Update="System.Core">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference>
    <Reference Update="System.Xml.Linq">
      <RequiredTargetFramework>3.5</RequiredTargetFramework>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Datasets\DataSetCollectionSpecimen.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DataSetCollectionSpecimen.xsd</DependentUpon>
    </Compile>
    <Compile Update="Datasets\DataSetExternalDatasource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DataSetExternalDatasource.xsd</DependentUpon>
    </Compile>
    <Compile Update="Forms\FormDiversityAgentsSettings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>FormDiversityAgentsSettings.settings</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="UserControls\ContactInformation.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <None Update="app.manifest">
      <SubType>Designer</SubType>
    </None>
    <None Update="Datasets\DataSetAgent.xsc">
      <DependentUpon>DataSetAgent.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetAgent.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetAgent1.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
    <None Update="Datasets\DataSetAgent.xss">
      <DependentUpon>DataSetAgent.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetCollectionSpecimen.xsc">
      <DependentUpon>DataSetCollectionSpecimen.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetCollectionSpecimen.xsd">
      <SubType>Designer</SubType>
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetCollectionSpecimen.Designer.cs</LastGenOutput>
    </None>
    <None Update="Datasets\DataSetCollectionSpecimen.xss">
      <DependentUpon>DataSetCollectionSpecimen.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetExternalDatasource.xsc">
      <DependentUpon>DataSetExternalDatasource.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetExternalDatasource.xsd">
      <SubType>Designer</SubType>
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetExternalDatasource.Designer.cs</LastGenOutput>
    </None>
    <None Update="Datasets\DataSetExternalDatasource.xss">
      <DependentUpon>DataSetExternalDatasource.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetProject.xsc">
      <DependentUpon>DataSetProject.xsd</DependentUpon>
    </None>
    <None Update="Datasets\DataSetProject.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DataSetProject1.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
    <None Update="Datasets\DataSetProject.xss">
      <DependentUpon>DataSetProject.xsd</DependentUpon>
    </None>
    <None Update="Forms\FormDiversityAgentsSettings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>FormDiversityAgentsSettings.Designer.cs</LastGenOutput>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="DA_C_favicon.ico" />
    <Content Include="DiversityAgents.ico" />
    <Content Include="Resources\JsonApi.ico" />
    <Content Include="Resources\info.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\DiversityWorkbench\DiversityWorkbench.csproj" />
  </ItemGroup>
</Project>